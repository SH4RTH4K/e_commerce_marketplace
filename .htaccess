# PLACE: public_html/

<IfModule mod_rewrite.c>
    Options -Indexes +FollowSymLinks
    RewriteEngine On

    # If the app is in a subdirectory, set this (e.g. RewriteBase /myshop/).
    # Leave as / when the Laravel app root is public_html.
    RewriteBase /

    # Block direct web access to sensitive Laravel paths.
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)($|/) - [F,L]
    RewriteRule ^(\.env|artisan|composer\.(json|lock)|phpunit\.xml|vite\.config\.js)($|/) - [F,L]

    # Already inside /public — do nothing.
    RewriteRule ^public/ - [L]

    # Send everything into the Laravel public folder.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Hide directory listing even if rewrite is unavailable.
Options -Indexes

<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
